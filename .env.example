# --- Database (SQLite) ---
# Path to the SQLite file (relative to project root or absolute).
DB_PATH=./db/ticketing.sqlite

# --- API server ---
PORT=3000
HOST=localhost
# CORS: use a precise origin in production (e.g. https://app.example.com), * only for dev.
CORS_ORIGIN=*

# --- Blockchain (Foundry / forge script) ---
# Local Anvil by default. Override for testnet/mainnet.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
NETWORK=localhost

# Deployer key — NEVER commit a real private key.
# For local dev only, you can use one of Anvil's well-known test keys.
# In production, use a hardware wallet or a keystore (forge --account <name>).
PRIVATE_KEY=

# Optional: contract verification
ETHERSCAN_API_KEY=

PINATA_JWT=your_jwt_token_here : THE TOKEN
PINATA_GATEWAY=https://gateway.pinata.cloud